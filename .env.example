# ============================================================
# 大连外国语大学 ACM 算法协会积分管理系统 - 环境变量示例
# 复制为 .env 后按环境修改。此文件不含任何真实秘密。
# 生产部署不得使用模拟认证（AUTH_DEV_SIMULATOR=false 且 NODE_ENV=production）。
# ============================================================

# --- 运行环境: development | test | production ---
NODE_ENV=development

# --- 数据库（PostgreSQL） ---
# 本地开发由 scripts/dev-postgres.sh 启动的实例（端口 5433，本地 trust 认证）。
# 生产部署使用独立强密码账号，并按 docs/deploy.md 拆分 api/worker/migrate 权限。
DATABASE_URL=postgresql://acm@127.0.0.1:5433/acm_club

# --- 服务端口 ---
API_PORT=8080
WEB_PORT=5173

# --- 对外站点地址（CAS service 与 Cookie 依赖，必须与反代对外 https 域名一致）---
PUBLIC_BASE_URL=http://localhost:5173

# --- 真实学校 CAS（默认启用；完整登录需校方允许精确 service 回调）---
CAS_BASE_URL=https://cas.dlufl.edu.cn
CAS_LOGIN_PATH=/cas/login
CAS_VALIDATE_PATH=/cas/proxyValidate
# 通常留空使用系统 DNS；fake-IP 代理环境可指定经公开 DNS 核对的公网 IP，TLS 仍校验 CAS 域名。
CAS_VALIDATE_ADDRESS=
CAS_LOGOUT_PATH=/cas/logout
# 学号所在属性名，须与校方真实契约核验后确认（参考 hydrooj-oauth-dlufl 为 id_number）
CAS_STUDENT_NO_ATTRIBUTE=id_number
CAS_REAL_NAME_ATTRIBUTE=user_name
CAS_STABLE_SUBJECT_ATTRIBUTE=user_id
# 允许的属性类型值：真实校方契约确认前留空表示不校验 id_type
CAS_ALLOWED_ID_TYPES=

# --- 本地测试可显式开启 CAS 模拟器；默认关闭，production 强制禁用 ---
AUTH_DEV_SIMULATOR=false
AUTH_DEV_SIMULATOR_PASSWORD=dev-only-please-change

# --- 会话与 Cookie ---
SESSION_TTL_HOURS=168
SESSION_IDLE_TTL_HOURS=12
# Cookie 名称带 __Host- 前缀要求 HTTPS 与 Path=/；本地 http 开发使用普通名
COOKIE_NAME=club_session
COOKIE_SECURE=false

# --- CSRF ---
CSRF_TTL_MINUTES=30

# --- 出站平台适配器（Worker 使用；均为官方稳定入口）---
PLATFORM_NOWCODER_HOST=ac.nowcoder.com
PLATFORM_CODEFORCES_HOST=codeforces.com
PLATFORM_ATCODER_HOST=atcoder.jp
PLATFORM_ATCODER_PROBLEMS_HOST=kenkoooo.com
PLATFORM_ATCODER_PROBLEMS_ENABLED=false
# fake-IP 代理环境可填写经 HTTPS 公共 DNS 核验的真实公网 IP；留空使用系统 DNS。
# 保留域名 SNI/TLS 校验与私网限制；CDN 地址可能变化，连接失败时重新核验，勿填 198.18.*。
PLATFORM_NOWCODER_ADDRESS=
PLATFORM_CODEFORCES_ADDRESS=
PLATFORM_ATCODER_ADDRESS=
PLATFORM_ATCODER_PROBLEMS_ADDRESS=
# 全局共享出站限流（Codeforces 官方要求 >= 2s）
OUTBOUND_MIN_INTERVAL_MS=2100
OUTBOUND_TIMEOUT_MS=15000
OUTBOUND_MAX_JSON_BYTES=1048576
OUTBOUND_MAX_STANDINGS_BYTES=16777216

# --- 校内 Hydro Bridge（未联调前 disabled）---
HYDRO_CONNECTOR_ENABLED=false

# --- 综评建议折算（附录三）---
# 测试口：开启后可对「未结束」的学期生成批次，产物强制标记为测试数据（页面与导出文件名均带标记）。
# 生产必须为 false（NODE_ENV=production 时开启会直接启动失败）。
EVALUATION_TEST_MODE=false

# --- 私有附件存储（开发环境受控本地目录）---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# 原始定位证据加密密钥引用（生产使用 KMS/环境注入，此处仅为占位示例）
ATTENDANCE_EVIDENCE_KEY_REF=dev-attendance-key

# --- 开发 seed（明显示例数据，不含真实凭证）---
SEED_DEMO_DATA=true
