{
  "name": "@acm/hydro-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "校内 Hydro OJ 附属 bridge 插件：本地事件 outbox + 签名 webhook + club-bridge 只读路由（docs/scheme/07-hydro-oj-plugin.md）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "hydrooj": ">=5.0.7 <6"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
