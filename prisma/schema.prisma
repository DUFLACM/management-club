model RoomBooking {
  id                String    @id @db.Uuid
  venueId           String?   @map("venue_id") @db.Uuid
  startsAt          DateTime @db.Timestamptz(3)  @map("starts_at")
  endsAt            DateTime @db.Timestamptz(3)  @map("ends_at")
  purpose           String
  contestLink       String?   @map("contest_link")
  applicantUserId   String    @map("applicant_user_id") @db.Uuid
  coApplicantUserIds String[] @map("co_applicant_user_ids")
  headcount         Int       @default(3)
  status            String    @default("pending") // pending | approved | rejected | cancelled
  approvedBy        String?   @map("approved_by") @db.Uuid
  approvedAt        DateTime? @db.Timestamptz(3) @map("approved_at")
  rejectionReason   String?   @map("rejection_reason")
  createdAt         DateTime @db.Timestamptz(3)  @default(now()) @map("created_at")

  @@index([startsAt, endsAt])
  @@map("room_bookings")
}

// ===========================================================================
// 十一、个人主页、徽标与媒体
// ===========================================================================

model UserProfile {
  userId              String  @id @map("user_id") @db.Uuid
  displayName         String? @map("display_name")
  bio                 String? @db.Text
  avatarAssetId       String? @map("avatar_asset_id") @db.Uuid
  visibility          String  @default("internal") // internal | self_only | public_opt_in
  themePreference     String  @default("light") @map("theme_preference")
  displayPreferences  Json?   @map("display_preferences")
  revision            Int     @default(1)
  updatedAt           DateTime @db.Timestamptz(3) @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model ProfileFeaturedBadge {
  userId  String @map("user_id") @db.Uuid
  slot    Int
  awardId String @map("award_id") @db.Uuid

  user  User        @relation(fields: [userId], references: [id])
  award BadgeAward  @relation(fields: [awardId], references: [id])

  @@unique([userId, slot])
  @@unique([awardId])
  @@map("profile_featured_badges")
}

model MediaAsset {
  id           String   @id @db.Uuid
  ownerUserId  String   @map("owner_user_id") @db.Uuid
  purpose      String // avatar | evidence | badge_icon
  status       String   @default("processing") // processing | ready | failed | purged
  mimeType     String?  @map("mime_type")
  width        Int?
  height       Int?
  frames       Int?
  contentHash  String?  @map("content_hash") @db.VarChar(64)
  storageKey   String?  @map("storage_key")
  variants     Json?
  visibility   String   @default("private")
  revision     Int      @default(1)
  createdAt    DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  @@index([ownerUserId])
  @@map("media_assets")
}

model BadgeDefinition {
  id           String   @id @db.Uuid
  key          String   @unique
  name         String
  description  String
  icon         String // 受控内置图标标识
  theme        String @default("blue") // blue | mint | lilac | amber
  category     String // honor | contribution | service | activity | growth
  grantMethod  String   @default("manual") @map("grant_method") // manual | rule
  isOfficialHonor Boolean @default(false) @map("is_official_honor")
  status       String   @default("active") // active | retired
  createdAt    DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  awards BadgeAward[]

  @@map("badge_definitions")
}

model BadgeRuleVersion {
  id           String   @id @db.Uuid
  definitionId String   @map("definition_id") @db.Uuid
  version      Int
  conditions   Json // 声明式条件，非可执行代码
  publicizedAt DateTime? @db.Timestamptz(3) @map("publicized_at")
  preview      Json?

  @@unique([definitionId, version])
  @@map("badge_rule_versions")
}

model BadgeAward {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  definitionId   String    @map("definition_id") @db.Uuid
  ruleVersion    Int?      @map("rule_version")
  sourceKey      String    @map("source_key")
  evidenceRef    String?   @map("evidence_ref")
  grantedBy      String?   @map("granted_by") @db.Uuid
  grantedAt      DateTime @db.Timestamptz(3)  @default(now()) @map("granted_at")
  expiresAt      DateTime? @db.Timestamptz(3) @map("expires_at")
  status         String    @default("active") // active | expired | revoked
  revokedReason  String?   @map("revoked_reason")

  user       User                  @relation(fields: [userId], references: [id])
  definition BadgeDefinition       @relation(fields: [definitionId], references: [id])
  featuredIn ProfileFeaturedBadge[]

  @@unique([sourceKey])
  @@index([userId, status])
  @@map("badge_awards")
}

// 分平台 rating/成绩序列（Algorithm 与 Heuristic、RP 观察快照不混合）
model PlatformRatingPoint {
  id                   String   @id @db.Uuid
  platform             String // nowcoder | codeforces | atcoder | hydro
  integrationInstanceId String? @map("integration_instance_id") @db.Uuid
  platformAccountId    String?  @map("platform_account_id") @db.Uuid
  seriesType           String   @map("series_type") // algorithm_rating | heuristic_rating | rp_snapshot
  externalEventId      String?  @map("external_event_id")
  contestKey           String?  @map("contest_key")
  occurredAt           DateTime @db.Timestamptz(3) @map("occurred_at")
  oldValue             Decimal? @map("old_value") @db.Decimal(12, 4)
  newValue             Decimal? @map("new_value") @db.Decimal(12, 4)
  snapshotValue        Decimal? @map("snapshot_value") @db.Decimal(12, 4)
  sourceRevision       Int      @default(1) @map("source_revision")
  completeness         String   @default("complete") // complete | partial | unknown

  platformAccount PlatformAccount?   @relation(fields: [platformAccountId], references: [id])
  integrationInstance IntegrationInstance? @relation(fields: [integrationInstanceId], references: [id])

  @@unique([platform, seriesType, platformAccountId, externalEventId])
  @@index([platformAccountId, seriesType, occurredAt])
  @@map("platform_rating_points")
}

