model SiteSettingVersion {
  id             String    @id @db.Uuid
  group          String // branding|general|term|rule_defaults|attendance_defaults|invite_policy|badges|privacy_disclosures|platforms|worker|review_rules|cas|security|maintenance|backups
  key            String
  schemaVersion  Int       @default(1) @map("schema_version")
  value          Json
  secretRef      String?   @map("secret_ref")
  status         String    @default("draft") // draft|validated|pending_approval|approved|published|rejected|superseded
  revision       Int       @default(1)
  changeSummary  String?   @map("change_summary")
  createdBy      String    @map("created_by") @db.Uuid
  approvedBy     String?   @map("approved_by") @db.Uuid
  publishedAt    DateTime? @db.Timestamptz(3) @map("published_at")
  effectiveAt    DateTime? @db.Timestamptz(3) @map("effective_at")
  revertOfId     String?   @map("revert_of_id") @db.Uuid
  createdAt      DateTime @db.Timestamptz(3)  @default(now()) @map("created_at")

  @@index([group, key, status])
  @@map("site_setting_versions")
}

model SettingEvent {
  id         String   @id @db.Uuid
  versionId  String   @map("version_id") @db.Uuid
  principalId String  @map("principal_id") @db.Uuid
  action     String // draft | validate | approve | publish | revert | reject
  note       String?
  createdAt  DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  @@index([versionId])
  @@map("setting_events")
}

model SecretReference {
  id          String   @id @db.Uuid
  key         String   @unique // cas_ticket_secret | hydro_push_secret::<instance> 等
  secretEnc   String   @map("secret_enc") // 加密存储，绝不通过 API 回显
  version     Int      @default(1)
  configured  Boolean  @default(true)
  lastRotated DateTime @db.Timestamptz(3) @default(now()) @map("last_rotated")
  disabledAt  DateTime? @db.Timestamptz(3) @map("disabled_at")

  @@map("secret_references")
}

model AuditLog {
  id                String   @id @db.Uuid
  actorPrincipalId  String?  @map("actor_principal_id") @db.Uuid
  action            String
  resourceType      String   @map("resource_type")
  resourceId        String   @map("resource_id")
  summary           String?  @db.Text
  beforeDigest      String?  @map("before_digest")
  afterDigest       String?  @map("after_digest")
  reason            String?
  createdAt         DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@index([actorPrincipalId, createdAt])
  @@map("audit_logs")
}

model AppMeta {
  key        String   @id
  value      Json
  updatedAt  DateTime @db.Timestamptz(3) @default(now()) @updatedAt @map("updated_at")

  @@map("app_meta")
}
